APP_NAME="Ktab-L7anout"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://relief.example.org
FRONTEND_URL=https://relief.example.org
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=postgres.example.org
DB_PORT=5432
DB_DATABASE=morocco_debt_relief
DB_USERNAME=mdr_runtime
DB_PASSWORD=
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/mdr/postgres-ca.pem
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=relief.example.org
FRONTEND_ORIGINS=
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
PRIVATE_STORAGE_ROOT=/srv/mdr/shared/evidence
SHOP_CLAMSCAN_BINARY=/usr/bin/clamscan
FUNDING_SIMULATOR_ENABLED=false
FUNDING_SIMULATOR_SECRET=
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.example.org
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@relief.example.org
